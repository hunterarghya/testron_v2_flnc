# Copy to .env for local development: `cp .env.example .env`.
# Every value below is a fake dev value. Never put real secrets in this file.
# Full reference: docs/dev_environment_and_deployment.md §2.1

# --- Django ---
# dev | prod. prod refuses to boot with DEBUG=True or without real secrets.
DJANGO_ENV=dev
DEBUG=True
SECRET_KEY=dev-insecure-secret-key-do-not-use-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Path of the Django back office. Use an unguessable slug in prod (security.md §4.5).
BACKOFFICE_PATH=backoffice

# --- Database (local Docker Postgres; Neon pooled/direct URLs in prod) ---
DATABASE_URL=postgres://app:app@localhost:5432/app
# Migrations and backups only
DATABASE_URL_DIRECT=postgres://app:app@localhost:5432/app

# --- Teacher account (used by `just seed`) ---
TEACHER_EMAIL=teacher@example.com
TEACHER_NAME="Dev Teacher"
# Applied only when the teacher is first created. Remove from prod env after the first seed.
TEACHER_INITIAL_PASSWORD=dev-teacher-password

# --- Keys ---
# Fernet keys, comma-separated (newest first) so keys can be rotated (ADR-018).
ASSIGNMENT_PASSWORD_KEY=ZGV2LW9ubHktYXNzaWdubWVudC1wYXNzd29yZC1rZXk=
OTP_HMAC_KEY=dev-otp-hmac-key-do-not-use-in-prod

# --- Email (Mailpit in dev: http://localhost:8025) ---
EMAIL_URL=smtp://localhost:1025
EMAIL_FROM=noreply@localhost

# --- Media (local adapter in dev; imagekit in prod) ---
MEDIA_BACKEND=local
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Google sign-in (empty hides the Google button) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Runtime ---
# Gunicorn workers (each with 4 threads). Only used by the container (`just full`).
WEB_CONCURRENCY=2
SENTRY_DSN=
# Proxies in front of the app that add X-Forwarded-For: 0 locally, 1 behind Caddy or Render
TRUSTED_PROXY_HOPS=0
# Must be 0 everywhere except E2E builds (ADR-036)
E2E_TEST_HOOKS=0

# APP_VERSION and APP_COMMIT are stamped into the image at build time (Dockerfile build
# args) and shown by /healthz. Don't set them here: this file would override them.
