{
  "openapi": "3.1.0",
  "info": {
    "title": "Test Platform API",
    "version": "1",
    "description": ""
  },
  "paths": {
    "/api/v1/healthz": {
      "get": {
        "operationId": "get_health",
        "summary": "Liveness and server time",
        "parameters": [
          {
            "in": "query",
            "name": "deep",
            "schema": {
              "default": false,
              "title": "Deep",
              "type": "boolean"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "get_csrf_cookie",
        "summary": "Set the CSRF cookie",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "description": "Sets the `csrftoken` cookie the SPA echoes on every unsafe request (SPA boot).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/email-verification/resend": {
      "post": {
        "operationId": "resend_verification",
        "summary": "Email a new verification code",
        "parameters": [],
        "responses": {
          "202": {
            "description": "Accepted"
          }
        },
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendVerificationIn"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "log_out",
        "summary": "Log out of this device",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password-reset": {
      "post": {
        "operationId": "request_password_reset",
        "summary": "Email a password reset code",
        "parameters": [],
        "responses": {
          "202": {
            "description": "Accepted"
          }
        },
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetIn"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/auth/password-reset/confirm": {
      "post": {
        "operationId": "confirm_password_reset",
        "summary": "Set a new password with the code (ends every session)",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetConfirmIn"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/auth/password": {
      "post": {
        "operationId": "change_password",
        "summary": "Change your own password",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordIn"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/auth/sign-up": {
      "post": {
        "operationId": "sign_up_with_password",
        "summary": "Create a student account (unverified)",
        "parameters": [],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignUpAcceptedOut"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpIn"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/auth/email-verification": {
      "post": {
        "operationId": "verify_email",
        "summary": "Verify the email with its code and log in",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUserOut"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailIn"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "log_in_with_password",
        "summary": "Log in with email and password",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUserOut"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "get_session",
        "summary": "Who is logged in (or null) and the server time",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/profile": {
      "patch": {
        "operationId": "update_profile_name",
        "summary": "Change your own name",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUserOut"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileIn"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthOut": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "server_now": {
            "format": "date-time",
            "title": "Server Now",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "commit": {
            "title": "Commit",
            "type": "string"
          }
        },
        "required": [
          "status",
          "server_now",
          "version",
          "commit"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "ResendVerificationIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 274,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "ResendVerificationIn",
        "type": "object"
      },
      "PasswordResetIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 274,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "PasswordResetIn",
        "type": "object"
      },
      "PasswordResetConfirmIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 274,
            "title": "Email",
            "type": "string"
          },
          "code": {
            "default": "",
            "maxLength": 12,
            "title": "Code",
            "type": "string"
          },
          "new_password": {
            "maxLength": 128,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "new_password"
        ],
        "title": "PasswordResetConfirmIn",
        "type": "object"
      },
      "ChangePasswordIn": {
        "additionalProperties": false,
        "properties": {
          "current_password": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Password"
          },
          "new_password": {
            "maxLength": 128,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "new_password"
        ],
        "title": "ChangePasswordIn",
        "type": "object"
      },
      "SignUpAcceptedOut": {
        "additionalProperties": false,
        "properties": {
          "email_masked": {
            "title": "Email Masked",
            "type": "string"
          }
        },
        "required": [
          "email_masked"
        ],
        "title": "SignUpAcceptedOut",
        "type": "object"
      },
      "SignUpIn": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 240,
            "title": "Name",
            "type": "string"
          },
          "email": {
            "maxLength": 274,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ],
        "title": "SignUpIn",
        "type": "object"
      },
      "SessionUserOut": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "role": {
            "enum": [
              "TEACHER",
              "STUDENT"
            ],
            "title": "Role",
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "UNVERIFIED",
                  "PENDING",
                  "ACTIVE",
                  "DECLINED",
                  "DEACTIVATED"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "has_password": {
            "title": "Has Password",
            "type": "boolean"
          },
          "performance_shared": {
            "title": "Performance Shared",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role",
          "status",
          "has_password",
          "performance_shared"
        ],
        "title": "SessionUserOut",
        "type": "object"
      },
      "VerifyEmailIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 274,
            "title": "Email",
            "type": "string"
          },
          "code": {
            "default": "",
            "maxLength": 12,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "VerifyEmailIn",
        "type": "object"
      },
      "LoginIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 274,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "SessionOut": {
        "additionalProperties": false,
        "properties": {
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionUserOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "server_now": {
            "format": "date-time",
            "title": "Server Now",
            "type": "string"
          }
        },
        "required": [
          "user",
          "server_now"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "ProfileIn": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 240,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProfileIn",
        "type": "object"
      }
    }
  },
  "servers": []
}
